# Copy this file to .env and fill it in. Everything business-specific lives here,
# so the same install works for any company. Keep .env private - it holds live keys.

# ── Who the outreach is from ──────────────────────────────────────────────
# Used in the email From: name ("Femi | Krediview"), the sign-off, and the dashboard.
COMPANY_NAME=Krediview
COMPANY_TAGLINE=Nigeria's Trusted Business Reviews Platform
SENDER_NAME=Femi
# Must be a sender address verified in Mailtrap.
MAIL_FROM_ADDRESS=info@krediview.com

# ── Where and what to search by default ───────────────────────────────────
# Both can be overridden per run in the dashboard or when /find-leads asks.
DEFAULT_LOCATION=Lagos, Nigeria
DEFAULT_CATEGORIES=restaurant, hotel, clinic, pharmacy, law firm, accounting firm, consulting firm, training academy, spa, retail boutique

# ── Service keys ──────────────────────────────────────────────────────────
# Google Maps search - https://console.apify.com/account/integrations
APIFY_API_KEY=
# Email sending - Mailtrap → Sending Domains → API tokens
MAILTRAP_API_KEY=
# Research and copywriting. Required for the dashboard's "Run /find-leads" button;
# the key is handed to the claude CLI so each install pays through its own account.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model for the dashboard's /find-leads runs, e.g. claude-haiku-5-5 (cheapest),
# claude-sonnet-5-5 or claude-opus-5-5. Blank uses Claude Code's default.
CLAUDE_MODEL=
